[Unit]
Description=Advance bounded TWILL transcript discovery without model calls
ConditionPathExists=%h/.config/twill/learning.json

[Service]
Type=oneshot
ExecStart=/usr/bin/env %h/.local/bin/twill-learning discover
# The hourly learning cycle holds the same lock during native experiments.
# A busy tick makes no changes and retries on its next timer activation.
SuccessExitStatus=3
MemoryMax=2G
CPUQuota=100%
# Bounded intake passes and private evidence publication share this budget.
TimeoutStartSec=8min
TimeoutStopSec=15s
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal
