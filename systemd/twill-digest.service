[Unit]
Description=Rank, explain, and render the weekly TWILL digest

[Service]
# A timer will not start another activation while this oneshot is active.
# Each TWILL verb also holds the shared state lock for defense in depth.
Type=oneshot
# Keep the installed path explicit while letting systemd-analyze verify the
# unit even on a checkout where the user's symlink has not been installed.
ExecStart=/usr/bin/env %h/.local/bin/twill rank
ExecStart=/usr/bin/env %h/.local/bin/twill explain
ExecStart=/usr/bin/env %h/.local/bin/twill digest
StandardOutput=journal
StandardError=journal
SyslogIdentifier=twill-digest
